{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/job/:id*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([wW]hats[aA]pp|[fF]acebookexternalhit|[tT]witterbot|[tT]elegram[bB]ot|[lL]inked[iI]n[bB]ot|[dD]iscordbot|[sS]kype[uU]ri[pP]review|[sS]lackbot|[gG]oogle|[cC]url|[wW]get).*"
        }
      ],
      "destination": "/api/job-meta?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
